# storyloop 环境变量模板（§6/§8）。
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不提交。
# LLM_API_KEY 只存在于服务器 .env，永远不会进入浏览器或任何 API 响应。

# 兼容 OpenAI 的接口地址（含 /v1）。缺省 https://api.openai.com/v1
LLM_BASE_URL=
# API Key。留空时调用真实 LLM 的接口会返回可读错误，而不是静默失败。
LLM_API_KEY=
# 模型名。缺省 gpt-4o-mini
LLM_MODEL=
# 单次 LLM 请求超时（毫秒）。缺省 180000
LLM_TIMEOUT=
# 日志等级：DEBUG / INFO / WARNING / ERROR。缺省 INFO
LOG_LEVEL=
# Run 产物根目录（相对仓库根或绝对路径）。缺省 runs
RUNS_DIR=
